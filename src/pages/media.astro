---
import BaseLayout from "../layouts/BaseLayout.astro";
import { curatedMedia, youtubeId } from "../lib/media";

const categoryCounts = new Map<string, number>();
for (const episode of curatedMedia) {
  const filterKeys = new Set([episode.category]);
  if (episode.tags.includes("podcast")) filterKeys.add("Podcast");

  for (const key of filterKeys) {
    categoryCounts.set(key, (categoryCounts.get(key) ?? 0) + 1);
  }
}

const mediaCategories = [
  {
    key: "Featured",
    label: "Featured",
    count: curatedMedia.filter((episode) => episode.featured).length,
  },
  ...Array.from(categoryCounts, ([label, count]) => ({
    key: label,
    label,
    count,
  })),
];

const mediaCards = curatedMedia.map((episode) => ({
  ...episode,
  videoId: youtubeId(episode.youtubeUrl),
  filterCategories: [
    ...(episode.featured ? ["Featured"] : []),
    episode.category,
    ...(episode.tags.includes("podcast") ? ["Podcast"] : []),
  ],
}));
---

<BaseLayout title="Media" description="Runze Tian's selected media shelf: podcasts, talks, and space content.">
  <section class="media-page" aria-label="Selected media" transition:animate="none">
    <header class="media-header">
      <h1>Media</h1>
      <p>Selected YouTube videos, podcasts, and space content, kept as a compact shelf.</p>
    </header>

    <div class="media-filters" aria-label="Media category filters">
      {
        mediaCategories.map((category) => (
          <button
            type="button"
            class={`media-filter${category.key === "Featured" ? " active" : ""}`}
            data-category={category.key}
            aria-pressed={category.key === "Featured" ? "true" : "false"}
          >
            [ {category.label} <span>{category.count}</span> ]
          </button>
        ))
      }
    </div>

    <section class="media-carousel-wrap" aria-label="Selected media shelf">
      <div class="media-carousel" id="media-carousel">
        <div class="media-carousel-spacer" aria-hidden="true"></div>

        {
          mediaCards.map((episode) => (
            <article
              class="media-card"
              id={`media-${episode.videoId || episode.number}`}
              data-video-id=""
              data-category={episode.category}
              data-filters={Array.from(new Set(episode.filterCategories)).join(" ")}
              data-featured={episode.featured ? "true" : "false"}
            >
              <button
                type="button"
                class="media-card-art"
                data-media-title={episode.title}
                data-media-url={episode.youtubeUrl}
                data-media-source={episode.category}
                aria-label={`Play ${episode.title}`}
              >
                <img
                  src={`https://img.youtube.com/vi/${episode.videoId}/hqdefault.jpg`}
                  alt=""
                  loading="lazy"
                />
                <span class="media-card-play" aria-hidden="true">▶</span>
              </button>

              <div class="media-card-content">
                <p class="media-card-note">{episode.note}</p>
                <h2>{episode.title}</h2>
                <p>{episode.description}</p>
                <div class="media-card-meta">
                  <span>#{episode.number}</span>
                  <span>{episode.host}</span>
                  <span>{episode.addedDate}</span>
                </div>
                <div class="media-card-tags" aria-label="Tags">
                  <span class="media-card-category">#{episode.category.toUpperCase()}</span>
                  {episode.featured && <span class="media-card-featured">#Featured</span>}
                </div>
              </div>
            </article>
          ))
        }

        <div class="media-carousel-spacer" aria-hidden="true"></div>
      </div>
    </section>

    <div class="media-scroll-nav" aria-label="Media shelf navigation">
      <button id="media-scroll-left" type="button">← prev</button>
      <button id="media-scroll-right" type="button">next →</button>
    </div>

    <footer class="media-stats">
      <span>{curatedMedia.length} selected items</span>
      <span>Click a cover to play in the sidebar</span>
    </footer>
  </section>

  <script is:inline>
    (function () {
      let cleanupFn = null;

      function parseYouTubeId(url) {
        try {
          var parsed = new URL(url, window.location.href);
          if (parsed.hostname.includes("youtu.be")) {
            return parsed.pathname.split("/").filter(Boolean)[0] || "";
          }
          if (parsed.pathname.startsWith("/embed/")) {
            return parsed.pathname.split("/")[2] || "";
          }
          if (parsed.pathname.startsWith("/shorts/")) {
            return parsed.pathname.split("/")[2] || "";
          }
          return parsed.searchParams.get("v") || "";
        } catch (_) {
          return "";
        }
      }

      function setActive(videoId) {
        document.querySelectorAll(".media-card").forEach(function (card) {
          card.classList.toggle("active", Boolean(videoId) && card.dataset.videoId === videoId);
        });
      }

      function filterValues(card) {
        return (card.dataset.filters || card.dataset.category || "").split(" ").filter(Boolean);
      }

      function applySelectedFilters(selectedFilters) {
        const filters = document.querySelectorAll(".media-filter");
        const cards = document.querySelectorAll(".media-card");

        filters.forEach(function (filter) {
          const active = selectedFilters.has(filter.dataset.category || "");
          filter.classList.toggle("active", active);
          filter.setAttribute("aria-pressed", active ? "true" : "false");
        });

        cards.forEach(function (card) {
          const values = filterValues(card);
          const show =
            selectedFilters.size === 0 ||
            Array.from(selectedFilters).every(function (filter) {
              return values.includes(filter);
            });
          card.style.display = show ? "" : "none";
        });
      }

      function init() {
        if (cleanupFn) cleanupFn();

        const abort = new AbortController();
        const cards = Array.from(document.querySelectorAll(".media-card"));
        const carousel = document.getElementById("media-carousel");
        const left = document.getElementById("media-scroll-left");
        const right = document.getElementById("media-scroll-right");
        const filters = document.querySelectorAll(".media-filter");
        const selectedFilters = new Set(
          Array.from(filters)
            .filter(function (filter) {
              return filter.classList.contains("active");
            })
            .map(function (filter) {
              return filter.dataset.category || "";
            })
            .filter(Boolean),
        );

        cards.forEach(function (card) {
          const button = card.querySelector(".media-card-art");
          const videoId = parseYouTubeId(button?.dataset.mediaUrl || "");
          card.dataset.videoId = videoId;
          const img = card.querySelector("img");
          if (img && videoId) {
            img.src = "https://img.youtube.com/vi/" + encodeURIComponent(videoId) + "/hqdefault.jpg";
          }
        });
        applySelectedFilters(selectedFilters);

        function visibleCards() {
          return cards.filter(function (card) {
            return card.style.display !== "none";
          });
        }

        function scrollToCard(index, behavior) {
          if (!carousel || !cards.length) return;
          const visible = visibleCards();
          if (!visible.length) return;
          const target = visible[Math.max(0, Math.min(index, visible.length - 1))];
          const carouselRect = carousel.getBoundingClientRect();
          const targetRect = target.getBoundingClientRect();
          carousel.scrollTo({
            left: carousel.scrollLeft + targetRect.left - carouselRect.left - (carousel.clientWidth - targetRect.width) / 2,
            behavior: behavior || "smooth",
          });
        }

        function showVideoInCarousel(videoId, behavior) {
          if (!videoId) return;
          const target = cards.find(function (card) {
            return card.dataset.videoId === videoId;
          });
          if (!target) return;
          if (target.style.display === "none") {
            selectedFilters.clear();
            const firstFilter = filterValues(target)[0] || target.dataset.category || "Featured";
            selectedFilters.add(firstFilter);
            applySelectedFilters(selectedFilters);
          }
          requestAnimationFrame(function () {
            scrollToCard(visibleCards().indexOf(target), behavior);
          });
        }

        document.addEventListener(
          "click",
          function (event) {
            const filter = event.target.closest(".media-filter");
            if (filter) {
              const category = filter.dataset.category || "";
              if (selectedFilters.has(category)) {
                selectedFilters.delete(category);
              } else {
                selectedFilters.add(category);
              }
              applySelectedFilters(selectedFilters);
              requestAnimationFrame(function () {
                scrollToCard(0);
              });
              return;
            }

            const button = event.target.closest(".media-card-art");
            if (!button || !window.playMedia) return;

            const videoId = parseYouTubeId(button.dataset.mediaUrl || "");
            if (!videoId) return;

            const ok = window.playMedia({
              title: button.dataset.mediaTitle,
              url: button.dataset.mediaUrl,
              videoId,
              source: button.dataset.mediaSource || "YouTube",
            });
            if (ok) {
              setActive(videoId);
              showVideoInCarousel(videoId);
            }
          },
          { signal: abort.signal },
        );

        document.addEventListener(
          "media:playing",
          function (event) {
            const videoId = event.detail && event.detail.videoId;
            setActive(videoId);
            showVideoInCarousel(videoId);
          },
          { signal: abort.signal },
        );

        // BaseLayout owns the player playlist mode; media page only replaces
        // the player when the user explicitly clicks a card.

        // Highlight the card for the currently playing track on entry.
        const currentTrack = window.__mediaPlayerState && window.__mediaPlayerState.currentTrack;
        if (currentTrack && currentTrack.videoId) {
          setActive(currentTrack.videoId);
          showVideoInCarousel(currentTrack.videoId, "auto");
        }

        function currentIndex() {
          if (!carousel) return 0;
          const visible = visibleCards();
          if (!visible.length) return 0;
          const rect = carousel.getBoundingClientRect();
          const targetLine = rect.left + rect.width / 2;
          return visible.reduce(
            function (best, card, index) {
              const cardRect = card.getBoundingClientRect();
              const distance = Math.abs(cardRect.left + cardRect.width / 2 - targetLine);
              return distance < best.distance ? { index, distance } : best;
            },
            { index: 0, distance: Infinity },
          ).index;
        }

        if (left) {
          left.addEventListener("click", () => scrollToCard(currentIndex() - 1), { signal: abort.signal });
        }
        if (right) {
          right.addEventListener("click", () => scrollToCard(currentIndex() + 1), { signal: abort.signal });
        }

        cleanupFn = function () {
          abort.abort();
        };
      }

      document.addEventListener("DOMContentLoaded", function () {
        requestAnimationFrame(init);
      });
      document.addEventListener("astro:page-load", function () {
        requestAnimationFrame(init);
      });
      document.addEventListener("astro:before-swap", function () {
        if (cleanupFn) {
          cleanupFn();
          cleanupFn = null;
        }
      });
    })();
  </script>
</BaseLayout>
