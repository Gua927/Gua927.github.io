---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const categoryOrder = ["pub-note", "paper", "notes", "methods", "ideas", "essays", "experiments"];
const categoryCounts = new Map<string, { label: string; count: number }>();
for (const post of posts) {
  const label = post.data.category ?? "notes";
  const key = label.toLowerCase();
  const current = categoryCounts.get(key);
  categoryCounts.set(key, { label, count: (current?.count ?? 0) + 1 });
}
const filters = [
  ...categoryOrder.filter((category) => categoryCounts.has(category)),
  ...Array.from(categoryCounts.keys()).filter((category) => !categoryOrder.includes(category)),
].map((category) => ({ key: category, ...categoryCounts.get(category)! }));

const tagCounts = new Map<string, { label: string; count: number }>();
for (const post of posts) {
  for (const label of post.data.tags) {
    const key = tagKey(label);
    const current = tagCounts.get(key);
    tagCounts.set(key, { label, count: (current?.count ?? 0) + 1 });
  }
}
const tagFilters = Array.from(tagCounts.entries())
  .map(([key, value]) => ({ key, ...value }))
  .sort((a, b) => a.label.localeCompare(b.label, undefined, { sensitivity: "base" }));

function formatDate(date: Date) {
  return date.toISOString().split("T")[0];
}

function categoryKey(post: (typeof posts)[number]) {
  return (post.data.category ?? "notes").toLowerCase();
}

function tagKey(tag: string) {
  return tag.toLowerCase();
}
---

<BaseLayout title="Blog" description="Runze Tian's notes, essays, and experiments.">
  <section class="notes-index-page" aria-label="Blog posts">
    <header class="notes-index-header">
      <h1>Blog</h1>
      <p>{posts.length} entries · personal notes and working ideas</p>
    </header>

    <div class="note-filter-panel" aria-label="Blog filters">
      <div class="note-kind-filters" aria-label="Category filters">
        <button type="button" data-kind="all" class="note-filter note-kind active" aria-pressed="true">
          [ All <span>{posts.length}</span> ]
        </button>
        {
          filters.map(({ key, label, count }) => (
            <button type="button" data-kind={key} class="note-filter note-kind" aria-pressed="false">
              [ {label} <span>{count}</span> ]
            </button>
          ))
        }
      </div>

      {
        tagFilters.length > 0 && (
          <div class="note-tag-filters" aria-label="Tag filters">
            <button type="button" data-tag="all" class="note-filter note-tag active" aria-pressed="true">
              #All <span>{posts.length}</span>
            </button>
            {tagFilters.map(({ key, label, count }) => (
              <button type="button" data-tag={key} class="note-filter note-tag" aria-pressed="false">
                #{label} <span>{count}</span>
              </button>
            ))}
          </div>
        )
      }
    </div>

    <div id="note-entries">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="note-entry"
            data-kind={categoryKey(post)}
            data-tags={post.data.tags.map(tagKey).join(" ")}
          >
            <div>
              <span>{post.data.category ?? "notes"}</span>
              <div>
                <h3>{post.data.title}</h3>
                <div>
                  {post.data.tags.map((tag) => (
                    <span>#{tag}</span>
                  ))}
                </div>
              </div>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            </div>
          </a>
        ))
      }
    </div>

    <div class="notes-empty hidden" data-empty-message>No entries match this index.</div>
    {posts.length === 0 && <div class="notes-empty">No entries yet.</div>}
  </section>

  <script is:inline>
    (function () {
      let cleanupFn = null;

      function init() {
        if (cleanupFn) {
          cleanupFn();
          cleanupFn = null;
        }

        const kindFilters = document.querySelectorAll(".note-kind");
        const tagFilters = document.querySelectorAll(".note-tag");
        const entries = document.querySelectorAll(".note-entry");
        const emptyMessage = document.querySelector("[data-empty-message]");
        if (!kindFilters.length) return;

        var activeKind = "all";
        var activeTags = new Set();

        function setActive(items, attr, value) {
          items.forEach((item) => {
            var active = item.dataset[attr] === value;
            item.classList.toggle("active", active);
            item.setAttribute("aria-pressed", active ? "true" : "false");
          });
        }

        function applyTagActiveState() {
          tagFilters.forEach((item) => {
            var tag = item.dataset.tag || "all";
            var active = tag === "all" ? activeTags.size === 0 : activeTags.has(tag);
            item.classList.toggle("active", active);
            item.setAttribute("aria-pressed", active ? "true" : "false");
          });
        }

        function applyFilters() {
          setActive(kindFilters, "kind", activeKind);
          applyTagActiveState();

          var visibleCount = 0;
          entries.forEach((entry) => {
            var kindMatches = activeKind === "all" || entry.dataset.kind === activeKind;
            var tags = (entry.dataset.tags || "").split(" ").filter(Boolean);
            var tagMatches =
              activeTags.size === 0 ||
              Array.from(activeTags).every((activeTag) => tags.indexOf(activeTag) !== -1);
            var show = kindMatches && tagMatches;
            entry.style.display = show ? "" : "none";
            if (show) visibleCount += 1;
          });

          if (emptyMessage) {
            emptyMessage.classList.toggle("hidden", visibleCount !== 0);
          }
        }

        function updateUrl() {
          var params = new URLSearchParams(window.location.search);
          if (activeKind === "all") params.delete("kind");
          else params.set("kind", activeKind);
          if (activeTags.size === 0) params.delete("tag");
          else params.set("tag", Array.from(activeTags).sort().join(","));
          var query = params.toString();
          var nextUrl = window.location.pathname + (query ? "?" + query : "") + window.location.hash;
          window.history.replaceState({}, "", nextUrl);
        }

        function onKindClick(e) {
          activeKind = e.currentTarget.dataset.kind || "all";
          applyFilters();
          updateUrl();
        }

        function onTagClick(e) {
          var tag = e.currentTarget.dataset.tag || "all";
          if (tag === "all") {
            activeTags.clear();
          } else if (activeTags.has(tag)) {
            activeTags.delete(tag);
          } else {
            activeTags.add(tag);
          }
          applyFilters();
          updateUrl();
        }

        kindFilters.forEach((filter) => filter.addEventListener("click", onKindClick));
        tagFilters.forEach((filter) => filter.addEventListener("click", onTagClick));

        var params = new URLSearchParams(window.location.search);
        var urlKind = params.get("kind");
        var urlTag = params.get("tag");
        if (urlKind) activeKind = urlKind.toLowerCase();
        if (urlTag) {
          urlTag
            .toLowerCase()
            .split(",")
            .map((tag) => tag.trim())
            .filter(Boolean)
            .forEach((tag) => activeTags.add(tag));
        }
        applyFilters();

        cleanupFn = function () {
          kindFilters.forEach((filter) => filter.removeEventListener("click", onKindClick));
          tagFilters.forEach((filter) => filter.removeEventListener("click", onTagClick));
        };
      }

      document.addEventListener("DOMContentLoaded", init);
      document.addEventListener("astro:page-load", init);
    })();
  </script>
</BaseLayout>
