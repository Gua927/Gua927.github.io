---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimelineList from "../components/TimelineList.astro";
import { frontmatter } from "../content/about.md";
---

<BaseLayout title="Runze Tian" description="Runze Tian's academic profile and generative AI notes.">
  <section class="profile-hero" id="about">
    <div class="hero-background" aria-hidden="true">
      <img src="/assets/img/profile-sea.jpg" alt="" width="1280" height="1707" />
    </div>

    <div class="profile-copy">
      <h1>
        <span>Tian Runze</span>
      </h1>
      <div class="subtitle" set:html={frontmatter.subtitle} />
      <p class="intro-text">
        I am interested in <strong>mathematics</strong> and <strong>AI</strong>. My current research
        focuses on <strong>generative AI</strong>, especially the relationship between probabilistic
        generation paths and the intrinsic structure of data, with work in molecular generation 🧬 and
        diffusion language models ✍️.
      </p>
      <p class="intro-text">
        This site organizes my Timeline, Publication, Blog, Podcast, and Projects as a compact record
        of research updates, notes, and work in progress.
      </p>
    </div>

    <section class="index-list" id="news" aria-label="Latest news">
      <div class="index-list-header">
        <span>News</span>
        <a href="/timeline/">[ View timeline ]</a>
      </div>
      <TimelineList limit={3} />
    </section>
  </section>
</BaseLayout>
