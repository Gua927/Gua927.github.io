---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimelineList from "../components/TimelineList.astro";
import PinnedNews from "../components/PinnedNews.astro";
import { frontmatter } from "../content/about.md";
import birthdayPhoto from "../../public/assets/gallery/singles/2026-10-29_2240_001.json";
---

<BaseLayout title="Runze Tian" description="Runze Tian's academic profile and generative AI notes.">
  <section class="profile-hero" id="about">
    <div class="hero-background" aria-hidden="true">
      <img src="/assets/img/profile-sea.jpg" alt="" width="1280" height="1707" />
    </div>

    <div class="profile-copy">
      <h1>
        <span>Tian Runze</span>
      </h1>
      <div class="subtitle" set:html={frontmatter.subtitle} />
      <p class="intro-text">
        I am interested in <strong>mathematics</strong> 🧮 and <strong>artificial intelligence</strong> 🤖.
        My current research focuses on <strong>generative AI</strong>, particularly the interplay between
        probabilistic generation trajectories and the intrinsic structure of data. I am currently exploring
        these ideas in molecular generation 🧬 and diffusion language models ✍️.
      </p>
      <p class="intro-text">
        This site organizes my <a href="/timeline/">Timeline</a>, <a href="/publication/">Publication</a>,
        <a href="/blog/">Blog</a>, <a href="/media/">Media</a>, <a href="/gallery/">Gallery</a>, and
        <a href="/relationship/">Relationship</a> as a
        compact record of research updates, notes, and photographs.
      </p>
    </div>

    <section class="index-list" id="news" aria-label="Latest news">
      <div class="index-list-header">
        <span>News</span>
        <a href="/timeline/">[ View timeline ]</a>
      </div>
      <TimelineList limit={3} categories={["publication", "blog"]}>
        <PinnedNews
          title="Happy birthday, 小皇帝! 🎂"
          href={`/gallery/#photo-${birthdayPhoto.id}`}
          date={birthdayPhoto.takenAt.slice(0, 10)}
          from="2026-11-06T00:00:00+08:00"
          until="2026-12-06T00:00:00+08:00"
        />
      </TimelineList>
    </section>
  </section>
</BaseLayout>
