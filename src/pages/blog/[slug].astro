---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(
  (heading) => heading.depth >= 1 && heading.depth <= 3 && !["footnote-label", "takeaway"].includes(heading.slug),
);
const categoryLabel = post.data.category ?? "notes";
const categoryHref = `/blog/?kind=${categoryLabel.toLowerCase()}`;
const affiliationHref = post.data.affiliationHref;

function formatDate(date: Date) {
  return `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
}
---

<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <div class="blog-post-shell">
    <header class="blog-post-header">
      <h1>{post.data.title}</h1>
      <p class="excerpt">{post.data.excerpt}</p>
    </header>

    <div class="blog-post-divider" aria-hidden="true"></div>

    <dl class="blog-post-meta" aria-label="Post details">
      <div>
        <dt>Author</dt>
        <dd><a href="/">{post.data.author}</a></dd>
      </div>
      <div>
        <dt>Affiliation</dt>
        <dd>
          <a href={affiliationHref} target="_blank" rel="noopener noreferrer">
            {post.data.affiliation}
          </a>
        </dd>
      </div>
      <div>
        <dt>Published</dt>
        <dd>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        </dd>
      </div>
      <div>
        <dt>Category</dt>
        <dd><a href={categoryHref}>{categoryLabel}</a></dd>
      </div>
    </dl>

    <div class="blog-post-divider blog-post-divider-meta" aria-hidden="true"></div>

    <article class="blog-post">
      <div class="markdown-content blog-post-content">
        <Content />
      </div>
    </article>

    {
      tocHeadings.length > 0 && (
        <aside class="blog-post-toc" aria-label="Table of contents">
          <span>Contents</span>
          <nav>
            {tocHeadings.map((heading) => (
              <a href={`#${heading.slug}`} class={`depth-${heading.depth}`}>
                {heading.text}
              </a>
            ))}
          </nav>
        </aside>
      )
    }
  </div>

  <script>
    (() => {
      let tocCleanup: (() => void) | undefined;
      let citationCleanup: (() => void) | undefined;
      let footnoteCleanup: (() => void) | undefined;

      function initBlogToc() {
        tocCleanup?.();

        const toc = document.querySelector<HTMLElement>(".blog-post-toc");
        if (!toc) return;

        const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>("a[href^='#']"));
        const entries = links
          .map((link) => {
            const id = decodeURIComponent(link.hash.slice(1));
            const heading = document.getElementById(id);
            return heading ? { link, heading } : null;
          })
          .filter(Boolean) as Array<{ link: HTMLAnchorElement; heading: HTMLElement }>;

        if (!entries.length) return;

        let frame = 0;

        function setActive(activeLink: HTMLAnchorElement) {
          for (const { link } of entries) {
            const isActive = link === activeLink;
            link.classList.toggle("is-active", isActive);
            if (isActive) {
              link.setAttribute("aria-current", "location");
            } else {
              link.removeAttribute("aria-current");
            }
          }
        }

        function updateActive() {
          frame = 0;
          const marker = window.innerHeight * 0.28;
          let active = entries[0];

          for (const entry of entries) {
            if (entry.heading.getBoundingClientRect().top <= marker) {
              active = entry;
            } else {
              break;
            }
          }

          setActive(active.link);
        }

        function queueUpdate() {
          if (frame) return;
          frame = window.requestAnimationFrame(updateActive);
        }

        updateActive();
        window.addEventListener("scroll", queueUpdate, { passive: true });
        window.addEventListener("resize", queueUpdate);

        tocCleanup = () => {
          if (frame) window.cancelAnimationFrame(frame);
          window.removeEventListener("scroll", queueUpdate);
          window.removeEventListener("resize", queueUpdate);
        };
      }

      function initCitationPreviews() {
        citationCleanup?.();

        const shells = Array.from(document.querySelectorAll<HTMLElement>(".citation-shell"));
        if (!shells.length) return;

        let activeShell: HTMLElement | null = null;
        let closeTimer = 0;

        function positionPreview(shell: HTMLElement) {
          const preview = shell.querySelector<HTMLElement>(".citation-preview");
          const content = shell.closest<HTMLElement>(".markdown-content");
          if (!preview || !content) return;

          const inset = 20;
          const contentRect = content.getBoundingClientRect();
          const triggerRect = shell.getBoundingClientRect();
          const width = Math.min(contentRect.width * 0.9, window.innerWidth - inset * 2);
          const centeredLeft = contentRect.left + (contentRect.width - width) / 2;
          const left = Math.min(
            Math.max(centeredLeft, inset),
            window.innerWidth - width - inset,
          );

          preview.style.setProperty("--citation-preview-left", `${left}px`);
          preview.style.setProperty("--citation-preview-width", `${width}px`);

          let top = triggerRect.bottom + 10;
          preview.style.setProperty("--citation-preview-top", `${top}px`);

          const previewHeight = preview.offsetHeight;
          if (top + previewHeight > window.innerHeight - 16) {
            top = Math.max(16, triggerRect.top - previewHeight - 10);
            preview.style.setProperty("--citation-preview-top", `${top}px`);
          }
        }

        function open(shell: HTMLElement) {
          window.clearTimeout(closeTimer);
          if (activeShell && activeShell !== shell) {
            activeShell.classList.remove("is-open");
          }

          activeShell = shell;
          shell.classList.add("is-open");
          positionPreview(shell);
        }

        function close(shell: HTMLElement) {
          shell.classList.remove("is-open");
          if (activeShell === shell) activeShell = null;
        }

        function scheduleClose(shell: HTMLElement) {
          window.clearTimeout(closeTimer);
          closeTimer = window.setTimeout(() => {
            const preview = shell.querySelector<HTMLElement>(".citation-preview");
            if (shell.matches(":hover, :focus-within") || preview?.matches(":hover, :focus-within")) {
              return;
            }
            close(shell);
          }, 180);
        }

        function repositionActive() {
          if (activeShell) positionPreview(activeShell);
        }

        const removers: Array<() => void> = [];

        for (const shell of shells) {
          const preview = shell.querySelector<HTMLElement>(".citation-preview");
          const onEnter = () => open(shell);
          const onLeave = () => scheduleClose(shell);
          const onFocus = () => open(shell);
          const onBlur = () => scheduleClose(shell);

          shell.addEventListener("pointerenter", onEnter);
          shell.addEventListener("pointerleave", onLeave);
          shell.addEventListener("focusin", onFocus);
          shell.addEventListener("focusout", onBlur);
          preview?.addEventListener("pointerenter", onEnter);
          preview?.addEventListener("pointerleave", onLeave);

          removers.push(() => {
            shell.removeEventListener("pointerenter", onEnter);
            shell.removeEventListener("pointerleave", onLeave);
            shell.removeEventListener("focusin", onFocus);
            shell.removeEventListener("focusout", onBlur);
            preview?.removeEventListener("pointerenter", onEnter);
            preview?.removeEventListener("pointerleave", onLeave);
          });
        }

        window.addEventListener("scroll", repositionActive, { passive: true });
        window.addEventListener("resize", repositionActive);

        citationCleanup = () => {
          window.clearTimeout(closeTimer);
          activeShell?.classList.remove("is-open");
          removers.forEach((remove) => remove());
          window.removeEventListener("scroll", repositionActive);
          window.removeEventListener("resize", repositionActive);
        };
      }

      function initFootnotePreviews() {
        footnoteCleanup?.();

        const refs = Array.from(document.querySelectorAll<HTMLAnchorElement>(".markdown-content a[data-footnote-ref]"));
        if (!refs.length) return;

        const shells: HTMLElement[] = [];

        for (const ref of refs) {
          const targetId = decodeURIComponent(ref.hash.slice(1));
          const target = document.getElementById(targetId);
          const shell = ref.closest<HTMLElement>("sup") || ref;
          if (!target || !shell) continue;

          const clone = target.cloneNode(true) as HTMLElement;
          clone.querySelectorAll("[data-footnote-backref]").forEach((node) => node.remove());
          const note = (clone.textContent || "").replace(/\s+/g, " ").trim();
          if (!note) continue;

          shell.classList.add("footnote-shell");
          shell.querySelector(".footnote-preview")?.remove();

          const preview = document.createElement("span");
          const item = document.createElement("span");
          const body = document.createElement("span");
          preview.className = "footnote-preview";
          item.className = "footnote-preview-item";
          body.className = "footnote-preview-body";
          body.textContent = note;
          item.append(body);
          preview.append(item);
          shell.append(preview);
          shells.push(shell);
        }

        if (!shells.length) return;

        let activeShell: HTMLElement | null = null;
        let closeTimer = 0;

        function positionPreview(shell: HTMLElement) {
          const preview = shell.querySelector<HTMLElement>(".footnote-preview");
          const content = shell.closest<HTMLElement>(".markdown-content");
          if (!preview || !content) return;

          const inset = 20;
          const contentRect = content.getBoundingClientRect();
          const triggerRect = shell.getBoundingClientRect();
          const width = Math.min(contentRect.width * 0.9, window.innerWidth - inset * 2);
          const centeredLeft = contentRect.left + (contentRect.width - width) / 2;
          const left = Math.min(
            Math.max(centeredLeft, inset),
            window.innerWidth - width - inset,
          );

          preview.style.setProperty("--footnote-preview-left", `${left}px`);
          preview.style.setProperty("--footnote-preview-width", `${width}px`);

          let top = triggerRect.bottom + 10;
          preview.style.setProperty("--footnote-preview-top", `${top}px`);

          const previewHeight = preview.offsetHeight;
          if (top + previewHeight > window.innerHeight - 16) {
            top = Math.max(16, triggerRect.top - previewHeight - 10);
            preview.style.setProperty("--footnote-preview-top", `${top}px`);
          }
        }

        function open(shell: HTMLElement) {
          window.clearTimeout(closeTimer);
          if (activeShell && activeShell !== shell) {
            activeShell.classList.remove("is-open");
          }

          activeShell = shell;
          shell.classList.add("is-open");
          positionPreview(shell);
        }

        function close(shell: HTMLElement) {
          shell.classList.remove("is-open");
          if (activeShell === shell) activeShell = null;
        }

        function scheduleClose(shell: HTMLElement) {
          window.clearTimeout(closeTimer);
          closeTimer = window.setTimeout(() => {
            const preview = shell.querySelector<HTMLElement>(".footnote-preview");
            if (shell.matches(":hover, :focus-within") || preview?.matches(":hover, :focus-within")) {
              return;
            }
            close(shell);
          }, 180);
        }

        function repositionActive() {
          if (activeShell) positionPreview(activeShell);
        }

        const removers: Array<() => void> = [];

        for (const shell of shells) {
          const preview = shell.querySelector<HTMLElement>(".footnote-preview");
          const onEnter = () => open(shell);
          const onLeave = () => scheduleClose(shell);
          const onFocus = () => open(shell);
          const onBlur = () => scheduleClose(shell);

          shell.addEventListener("pointerenter", onEnter);
          shell.addEventListener("pointerleave", onLeave);
          shell.addEventListener("focusin", onFocus);
          shell.addEventListener("focusout", onBlur);
          preview?.addEventListener("pointerenter", onEnter);
          preview?.addEventListener("pointerleave", onLeave);

          removers.push(() => {
            shell.removeEventListener("pointerenter", onEnter);
            shell.removeEventListener("pointerleave", onLeave);
            shell.removeEventListener("focusin", onFocus);
            shell.removeEventListener("focusout", onBlur);
            preview?.removeEventListener("pointerenter", onEnter);
            preview?.removeEventListener("pointerleave", onLeave);
          });
        }

        window.addEventListener("scroll", repositionActive, { passive: true });
        window.addEventListener("resize", repositionActive);

        footnoteCleanup = () => {
          window.clearTimeout(closeTimer);
          activeShell?.classList.remove("is-open");
          removers.forEach((remove) => remove());
          window.removeEventListener("scroll", repositionActive);
          window.removeEventListener("resize", repositionActive);
        };
      }

      function initBlogPostInteractions() {
        initBlogToc();
        initCitationPreviews();
        initFootnotePreviews();
      }

      document.addEventListener("DOMContentLoaded", initBlogPostInteractions);
      document.addEventListener("astro:page-load", initBlogPostInteractions);
      document.addEventListener("astro:before-swap", () => {
        tocCleanup?.();
        citationCleanup?.();
        footnoteCleanup?.();
      });
    })();
  </script>
</BaseLayout>
