---
import type { CollectionEntry } from "astro:content";
import PostHeader from "./PostHeader.astro";
import "../styles/essay.css";

interface Props {
  post: CollectionEntry<"blog">;
  categoryHref: string;
}

const { post, categoryHref } = Astro.props;
const { dropCap, showAffiliation, endMark } = post.data.essay;
---

<div class="blog-post-shell essay-post-shell" lang={post.data.lang ?? "zh-CN"}>
  <PostHeader post={post} categoryHref={categoryHref} showAffiliation={showAffiliation}>
    <p slot="kicker" class="essay-post-kicker">
      <a href={categoryHref}>Essay</a>
      {post.data.tags.map((tag) => <><span aria-hidden="true">/</span><span>{tag}</span></>)}
    </p>
  </PostHeader>

  <article class="blog-post essay-post">
    <div class:list={["markdown-content essay-post-content", { "has-drop-cap": dropCap }]}>
      <slot />
    </div>
    <footer class="essay-post-footer">
      <a href={categoryHref}>← Essays</a>
      {endMark && <span class="essay-end-mark">{endMark}</span>}
    </footer>
  </article>
</div>
