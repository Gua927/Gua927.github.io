---
import {
  formatTimelineDate,
  getTimelineEntries,
  timelineLabels,
  type TimelineCategory,
} from "../lib/timeline";

interface Props {
  limit?: number;
  categories?: TimelineCategory[];
  class?: string;
}

const { limit, categories, class: className = "" } = Astro.props;

const categorySet = categories ? new Set<TimelineCategory>(categories) : undefined;
const entries = (await getTimelineEntries())
  .filter((entry) => !categorySet || categorySet.has(entry.category))
  .slice(0, limit);
---

<ul class:list={["timeline-list", className]}>
  {
    entries.map((entry) => {
      return (
        <li class="timeline-item">
          <a href={entry.href}>
            <span class="timeline-meta">
              {formatTimelineDate(entry.date)} · {timelineLabels[entry.category] ?? entry.category}
            </span>
            <span class="timeline-separator" aria-hidden="true">—</span>
            <strong>{entry.title}</strong>
          </a>
        </li>
      );
    })
  }
</ul>
